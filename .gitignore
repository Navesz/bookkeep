# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# typescript
*.tsbuildinfo
next-env.d.ts

# the database is data, not source
# It is born in the project root the moment anyone runs the app, and it holds
# member names and e-mail addresses. This repository is public: a committed
# .db is a personal-data leak that survives in the history even after the file
# is deleted. The project it replaces committed its .env.local for the same
# reason — nobody meant to.
*.db
*.db-shm
*.db-wal
